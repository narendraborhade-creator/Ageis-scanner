{
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/Aegis-3D-Safe-Browser.apk",
      "destination": "https://github.com/narendraborhade-creator/Ageis-scanner/releases/download/v1.0.0/Aegis-3D-Safe-Browser.apk",
      "permanent": false
    },
    {
      "source": "/downloads/Aegis-3D-Safe-Browser.apk",
      "destination": "https://github.com/narendraborhade-creator/Ageis-scanner/releases/download/v1.0.0/Aegis-3D-Safe-Browser.apk",
      "permanent": false
    },
    {
      "source": "/download/apk",
      "destination": "https://github.com/narendraborhade-creator/Ageis-scanner/releases/download/v1.0.0/Aegis-3D-Safe-Browser.apk",
      "permanent": false
    },
    {
      "source": "/download/setup",
      "destination": "https://github.com/narendraborhade-creator/Ageis-scanner/releases/download/v1.0.0/Aegis-3D-Safe-Browser-Setup-1.0.0.exe",
      "permanent": false
    },
    {
      "source": "/download/portable",
      "destination": "https://github.com/narendraborhade-creator/Ageis-scanner/releases/download/v1.0.0/Aegis-3D-Safe-Browser-1.0.0.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
